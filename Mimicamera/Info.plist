<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>Mimicamera uses the camera to apply photographic style transfer to your live viewfinder.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Mimicamera reads reference photos from your library to learn the colours to apply to your camera feed.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Mimicamera saves captured photos (original and styled) to your library.</string>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string></string>
    </dict>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
        <string>video-camera</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>
</dict>
</plist>
